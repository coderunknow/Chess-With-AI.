{
  "name": "ai-chess-companion",
  "version": "0.7.2",
  "description": "Play chess against Gemini, ChatGPT, Claude, Grok, Perplexity and Copilot from Chrome's side panel.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/coderunknow/Chess-With-AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderunknow/Chess-With-AI.git"
  },
  "bugs": {
    "url": "https://github.com/coderunknow/Chess-With-AI/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:manifest": "node scripts/check-manifest.mjs",
    "sync:manifest": "node scripts/sync-manifest.mjs",
    "dev:smoke": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "verify": "npm run check:manifest && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  }
}
